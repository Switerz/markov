# GoGraph — production .env (server-side, NEVER commit the real file)
# Copy this to `.env` on the server before first deploy.

# --- Metabase (data source) ---
METABASE_URL=https://your-metabase.example.com
METABASE_API_KEY=

# --- Database IDs (inside Metabase) ---
DB_PLAUSIBLE=70
DB_DATAMART=63

# --- Analysis window (defaults for ad-hoc runs) ---
START_DATE=2026-05-01
END_DATE=2026-05-31
LOOKBACK_DAYS=30

# --- Model parameters ---
NON_CONV_SAMPLE_PCT=1
NON_CONV_SCALE=
DECAY_LAMBDA=0.05
SHAPLEY_SAMPLES=5000
MODEL_BATCH_MODE=auto
MODEL_BATCH_DAYS=35
CENSORSHIP_DAYS=0

# --- Containers ---
# Path used inside the backend container. Volume `gograph_db` persists this.
DOCKER_DATABASE_URL=sqlite:////app/db/gograph.db

# CORS — list of allowed origins for the API (comma-separated).
# Add the production frontend URL here.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Frontend base URL — passed at build time so the SPA knows where the API is.
# In prod, nginx proxies /api/* to the backend container, so use `/api`.
VITE_API_BASE=/api

# Optional: Postgres profile (only when --profile pg is enabled)
POSTGRES_PASSWORD=
